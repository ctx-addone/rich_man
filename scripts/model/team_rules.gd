class_name RichTeamRules
extends RefCounted

# Evidence supports team survival/wealth wins, rent exemption and allied upgrades.
# Scoring of eliminated teammates and upgrade payer are explicit test policies.
const TEST_PROFILE = {"include_bankrupt_winners":true,"score_bankrupt_members":false,"upgrade_payer":"acting_player","maximum_team_id":3}

static func valid_assignment(assignment:Variant,count:int)->bool:
	if not assignment is Array or count<2 or count>4 or assignment.size()!=count: return false
	var seen:Dictionary={}
	for team in assignment:
		if not team is int or team<0 or team>TEST_PROFILE.maximum_team_id: return false
		seen[team]=true
	return seen.size()>=2

static func assign(g,assignment:Variant)->void:
	var valid:bool=valid_assignment(assignment,g.players.size())
	for who in range(g.players.size()): g.players[who].team=int(assignment[who]) if valid else who
	if assignment!=null and not valid: g._log("队伍配置无效，已恢复每人独立阵营；需2～4个阵营，编号0～3。")

static func _valid_player(g,who:int)->bool:
	return who>=0 and who<g.players.size()

static func _valid_team(team:Variant)->bool:
	if team is int: return team>=0 and team<=TEST_PROFILE.maximum_team_id
	# Compatibility for older in-memory trait fixtures, never generated by setup.
	return team is String and not team.is_empty() and team!="-1"

static func same(g,a:int,b:int)->bool:
	if not _valid_player(g,a) or not _valid_player(g,b): return false
	if a==b: return true
	var left:Variant=g.players[a].get("team",null)
	var right:Variant=g.players[b].get("team",null)
	return _valid_team(left) and _valid_team(right) and typeof(left)==typeof(right) and left==right

static func opponent(g,a:int,b:int)->bool:
	return _valid_player(g,a) and _valid_player(g,b) and not same(g,a,b)

static func members(g,team_id:int,include_bankrupt:bool=true)->Array[int]:
	var result:Array[int]=[]
	for who in range(g.players.size()):
		var team:Variant=g.players[who].get("team",null)
		if team is int and team==team_id and (include_bankrupt or not g.players[who].bankrupt): result.append(who)
	return result

static func _score_key(g,who:int)->Variant:
	var team:Variant=g.players[who].get("team",null)
	return team if _valid_team(team) else "independent:%d"%who

static func scores(g)->Dictionary:
	var result:Dictionary={}
	for who in range(g.players.size()):
		if g.players[who].bankrupt: continue
		var key:Variant=_score_key(g,who)
		result[key]=int(result.get(key,0))+g.net_worth(who)
	return result

static func active(g)->Array[int]:
	var result:Array[int]=[]
	for team in scores(g):
		if team is int: result.append(team)
	return result

static func winner_members(g)->Array[int]:
	var result:Array[int]=[]
	var totals:Dictionary=scores(g)
	var best:int=-1
	for value in totals.values(): best=maxi(best,value)
	for who in range(g.players.size()):
		var key:Variant=_score_key(g,who)
		if totals.has(key) and totals[key]==best: result.append(who)
	return result
