extends "res://tests/ui_test.gd"

func run() -> void:
	DirAccess.make_dir_recursive_absolute(out_dir)
	root.size = Vector2i(1440, 900)
	app = load("res://scenes/main.tscn").instantiate()
	app.shop_policy = "legacy_v8" # Preserve historical scenarios; R18 covers the new shop.
	app.npcs_enabled = false # Preserve the pre-NPC scenario; R17 tests cover NPCs.
	app.controllers.assign(["human", "human", "human", "human"])
	app.talents_enabled = false
	app.gods_enabled = false
	# This historical fixture exercises the fixed shop; round9_ui_test covers random stock.
	app.specials_enabled = false
	root.add_child(app)
	await click("开始游戏")
	await click("选择角色")
	await click("开始对局")
	await click("我已就位")
	app.gm_used = true
	var lot: Dictionary = app.game.lots.lot_1_1
	app.game.gm_teleport(0, int(lot.frontage_nodes[0]))
	app.refresh()
	await click("购买地产")
	await capture("11-building-choice")
	await click("选择 大饭店")
	check(lot.building_type == "hotel" and lot.owner == 0, "hotel selected through purchase UI")
	await click("结束回合")
	await click("我已就位")
	app.game.gm_teleport(1, int(lot.frontage_nodes[1]))
	app.refresh()
	check(app.game.players[1].status.kind == "vacation", "opponent landing enters hotel vacation")
	await capture("12-hotel")
	app.start_game()
	await click("我已就位")
	app.gm_used = true
	lot = app.game.lots.lot_1_1
	app.game.gm_teleport(0, int(lot.frontage_nodes[0]))
	app.refresh()
	await click("购买地产")
	await click("选择 研究所")
	check(lot.building_type == "lab", "research building selected")
	app.game.gm_teleport(0, int(lot.frontage_nodes[0]))
	app.refresh()
	await click("安排研究")
	await click("研究 ")
	check(lot.research.get("card_id", "") == "portal", "research starts actual portal project")
	await capture("13-research")
	for ignored in range(8):
		app.game.gm_teleport(app.game.current, 0)
		app.game.end_turn()
	app.refresh()
	check(app.game.players[0].cards.has("portal"), "completed research grants usable card")
	var shop: Dictionary = app.game.facility_lot("shop")
	app.game.gm_teleport(0, int(shop.frontage_nodes[0]))
	app.refresh()
	check(app.game.phase == "shop", "shop service opens on landing")
	await click("浏览商店")
	await capture("14-shop")
	var before: int = app.game.players[0].cash
	await click("购买卡牌 · 查账")
	check(app.game.players[0].cards.has("audit") and app.game.players[0].cash < before, "shop purchase spends cash and gives card")
	await click("返回对局")
	while app.game.players[0].cards.size() < app.game.HAND_LIMIT: app.game.give_card(0, "dice")
	app.refresh()
	await click("浏览商店")
	var purchase := find_button(app, "购买卡牌")
	check(purchase != null and purchase.disabled, "full hand disables purchase")
	await click("返回对局")
	await click("弃")
	check(app.game.players[0].cards.size() == 7, "manual discard frees hand slot")
	for ignored in range(app.game.shop_remaining()):
		await click("浏览商店")
		await click("购买卡牌 · 遥控")
		await click("返回对局")
		await click("弃")
	await click("浏览商店")
	check(app.game.shop_remaining() == 0 and app.game.players[0].cards.size() < 8 and find_button(app, "购买卡牌").disabled, "visit quota blocks purchase even with free hand slot")
	await capture("16-shop-quota")
	await click("返回对局")
	await click("离开商店")
	check(app.game.phase == "end", "shop closes once")
	await click("卡牌图鉴")
	await capture("15-card-catalog")
	await click("关闭")
	check(app.popup == null, "catalog closes to match")
	app.start_game()
	await click("我已就位")
	app.gm_used = true
	app.game.gm_give_card(0, "audit")
	app.refresh()
	await click("查账卡")
	await click("确认使用")
	check(app.game.players[0].cash == 11500 and app.game.players[1].cash == 8500, "player-target card UI applies to selected opponent")
	var small: Dictionary = app.game.lots.small_1_6
	app.game.gm_teleport(0, int(small.frontage_nodes[0]))
	app.game.buy_property(small.id, "house")
	app.game.end_turn()
	for ignored in range(3):
		app.game.gm_teleport(app.game.current, 0)
		app.game.end_turn()
	app.game.gm_give_card(0, "rebuild")
	app.refresh()
	await click("改建卡")
	var building_choice: OptionButton = app.popup.find_child("CardBuildingChoice", true, false)
	check(building_choice != null and building_choice.item_count == 2, "lot-target rebuild offers small-building types")
	if building_choice != null: building_choice.select(1)
	await click("确认使用")
	check(small.building_type == "chain", "lot ID and selected building type reach card effect")
	await capture("17-chain-card")
	print("R3_UI failures=", failures)
	quit(1 if failures else 0)
